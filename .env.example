# Local configuration. Keep credentials here, never in client code.
PORT=4310
BIND_HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5178
# Optional locally; required before listening beyond loopback. At least 24 characters.
OWNER_ACCESS_CODE=
PAYMENT_MODE=demo
# Set PAYMENT_MODE=sandbox to enable PayPal. Production payments are unsupported.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional verified capture/refund/reversal callbacks. A public HTTPS URL is required.
PAYPAL_WEBHOOK_ID=
# Optional server-side AI extraction. All three settings are required.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
