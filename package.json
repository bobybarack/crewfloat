{
  "name": "crewfloat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "dev:cloudflare": "wrangler pages dev -c wrangler.jsonc -c cloudflare/wrangler.jsonc --port 8788",
    "deploy:api": "wrangler deploy -c cloudflare/wrangler.jsonc",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist --project-name crewfloat --branch main",
    "check:cloudflare": "tsc --noEmit -p cloudflare/tsconfig.json",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@7.3.7",
    "@bryntum/scheduler-react": "7.3.7",
    "@fontsource-variable/manrope": "5.3.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wrangler": "^4.156.0"
  }
}
