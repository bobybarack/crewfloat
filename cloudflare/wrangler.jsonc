{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "crewfloat-api",
  "main": "worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"APP_ORIGIN": "https://crewfloat.pages.dev", "PAYMENT_MODE": "demo"},
  "durable_objects": {"bindings": [{"name": "WORKSPACES", "class_name": "CrewWorkspace"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["CrewWorkspace"]}],
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
